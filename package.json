{
  "name": "discordctl",
  "version": "0.1.0",
  "description": "Infrastructure as Code for Discord servers: declarative YAML, plan/apply, permission auditing, and an MCP server for AI agents.",
  "type": "module",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22.16.0"
  },
  "bin": {
    "discordctl": "./dist/cli/main.js",
    "discordctl-mcp": "./dist/mcp/main.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "templates",
    "examples",
    "docs",
    "README.md",
    "LICENSE",
    "NOTICE",
    "SECURITY.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsx src/cli/main.ts",
    "mcp": "tsx src/mcp/main.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "DISCORDCTL_IT=1 vitest run tests/integration",
    "check": "pnpm typecheck && pnpm test",
    "prepack": "pnpm build",
    "prepublishOnly": "pnpm typecheck && pnpm test"
  },
  "keywords": [
    "claude",
    "cli",
    "discord",
    "discord-bot",
    "iac",
    "infrastructure-as-code",
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "permissions",
    "terraform"
  ],
  "dependencies": {
    "@discordjs/rest": "^2.6.3",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "commander": "^15.0.0",
    "discord-api-types": "^0.38.56",
    "picocolors": "^1.1.1",
    "yaml": "^2.9.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  },
  "packageManager": "pnpm@12.9.1",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/paezao/discordctl.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "homepage": "https://github.com/paezao/discordctl#readme",
  "bugs": {
    "url": "https://github.com/paezao/discordctl/issues"
  }
}
