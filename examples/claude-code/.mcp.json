{
  "mcpServers": {
    "discordctl": {
      "command": "npx",
      "args": [
        "-y",
        "-p",
        "discordctl",
        "discordctl-mcp"
      ],
      "env": {
        "DISCORD_TOKEN": "${DISCORD_TOKEN}",
        "DISCORDCTL_ALLOWED_GUILDS": "${DISCORD_GUILD_ID}"
      }
    }
  }
}
