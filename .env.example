# Discord bot token (Developer Portal → your application → Bot → Reset Token).
# Bot tokens only — never a user account token. Keep this file out of version control.
DISCORD_TOKEN=

# Guild (server) ID used by ${DISCORD_GUILD_ID} in configuration files.
# Discord → Settings → Advanced → Developer Mode, then right-click the server → Copy Server ID.
DISCORD_GUILD_ID=

# Optional: restrict discordctl (CLI and MCP) to these guild IDs, comma-separated.
# DISCORDCTL_ALLOWED_GUILDS=123456789012345678

# Optional: state database location (default ./.discordctl/state.db).
# DISCORDCTL_STATE=.discordctl/state.db

# MCP server options
# DISCORDCTL_MCP_ALLOW_APPLY=0          # 1 registers discord_apply_plan (still requires human approval)
# DISCORDCTL_MCP_APPROVAL=elicitation-or-cli   # or "cli" to require `discordctl approve <planId>`
# DISCORDCTL_PLAN_TTL_SECONDS=900       # plan expiry (60-3600)
# DISCORDCTL_MCP_ROOT=.                 # config files readable by the MCP server must be inside this dir

# Optional real-Discord integration test (creates and deletes "dctl-it-*" resources)
# DISCORDCTL_IT=1
# DISCORDCTL_IT_TOKEN=
# DISCORDCTL_IT_GUILD=
# DISCORDCTL_IT_ALLOW_MUTATION=1
